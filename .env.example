# Copy this file to .env and fill in the key to switch on the Gemini tutor.
# Without a key everything still works: the built-in tutor answers from the simulator's engine.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# First choice, then the fallbacks tried in order if a model is unavailable, busy or retired.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash

# Optional
PORT=3000
GEMINI_TIMEOUT_MS=30000
AI_RATE_LIMIT=20
